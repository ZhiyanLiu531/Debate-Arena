import React, { useState, useEffect, useRef } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { startAIDebate, getAIDebate, sendMessageToAI, endAIDebate } from '../api/aiDebates';

export default function AIDebatePage({ user }) {
  const { debateId } = useParams();
  const navigate = useNavigate();
  const scrollRef = useRef(null);
  const isAtBottomRef = useRef(true);

  const [debate, setDebate] = useState(null);
  const [messages, setMessages] = useState([]);
  const [inputText, setInputText] = useState('');
  const [loading, setLoading] = useState(true);
  const [sending, setSending] = useState(false);
  const [error, setError] = useState('');
  const [topic, setTopic] = useState('');
  const [userSide, setUserSide] = useState('pro');
  const [showStartModal, setShowStartModal] = useState(!debateId);

  // Reset modal based on debateId
  useEffect(() => {
    setShowStartModal(!debateId);
  }, [debateId]);

  // Auto-scroll to bottom
  useEffect(() => {
    if (isAtBottomRef.current && scrollRef.current) {
      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
    }
  }, [messages]);

  // Load debate if debateId exists
  useEffect(() => {
    async function loadDebate() {
      if (!debateId) return;

      try {
        const res = await getAIDebate(debateId);
        if (!res.ok) {
          setError('Failed to load debate');
          return;
        }
        const data = await res.json();
        setDebate(data.debate);
        setMessages(data.debate.messages || []);
        setTopic(data.debate.topic);
        setUserSide(data.debate.userSide);
      } catch (err) {
        console.error('Error loading debate:', err);
        setError('Failed to load debate');
      } finally {
        setLoading(false);
      }
    }

    loadDebate();
  }, [debateId]);

  const handleStartDebate = async () => {
    if (!topic.trim() || !userSide) {
      setError('Please fill in all fields');
      return;
    }

    setSending(true);
    try {
      const res = await startAIDebate({ topic: topic.trim(), userSide });
      if (!res.ok) {
        const err = await res.json();
        setError(err.error || 'Failed to start debate');
        setSending(false);
        return;
      }

      const data = await res.json();
      setDebate(data.debate);
      setMessages([]);
      setShowStartModal(false);
      navigate(`/ai-debate/${data.debate._id}`);
    } catch (err) {
      console.error('Error starting debate:', err);
      setError('Failed to start debate');
      setSending(false);
    }
  };

  const handleSendMessage = async () => {
    if (!inputText.trim() || !debate || sending) return;

    const userMessage = inputText.trim();
    setSending(true);
    setInputText('');

    // Add user message immediately
    setMessages(prev => [...prev, { role: 'user', content: userMessage, timestamp: new Date() }]);

    try {
      const res = await sendMessageToAI(debate._id, userMessage);
      if (!res.ok) {
        const err = await res.json();
        setError(err.error || 'Failed to send message');
        setSending(false);
        return;
      }

      const data = await res.json();
      setMessages(data.debate.messages || []);
      setDebate(data.debate);
    } catch (err) {
      console.error('Error sending message:', err);
      setError('Failed to send message');
    } finally {
      setSending(false);
    }
  };

  const handleEndDebate = async () => {
    if (!window.confirm('Are you sure you want to end this debate?')) return;

    try {
      const res = await endAIDebate(debate._id);
      if (!res.ok) {
        setError('Failed to end debate');
        return;
      }
      alert('Debate ended!');
      navigate('/');
    } catch (err) {
      console.error('Error ending debate:', err);
      setError('Failed to end debate');
    }
  };

  const handleScroll = () => {
    if (scrollRef.current) {
      const { scrollTop, scrollHeight, clientHeight } = scrollRef.current;
      isAtBottomRef.current = scrollHeight - scrollTop - clientHeight < 100;
    }
  };

  if (loading && debateId) {
    return (
      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '100vh', backgroundColor: '#f5f0e6' }}>
        <div style={{ fontSize: '1.2rem', color: '#666' }}>Loading debate...</div>
      </div>
    );
  }

  if (showStartModal) {
    return (
      <div style={{
        backgroundColor: '#f5f0e6',
        minHeight: '100vh',
        padding: '2rem',
        display: 'flex',
        justifyContent: 'center',
        alignItems: 'center'
      }}>
        <div style={{
          backgroundColor: 'white',
          borderRadius: '16px',
          padding: '2rem',
          maxWidth: '500px',
          width: '100%',
          boxShadow: '0 10px 25px rgba(0,0,0,0.2)'
        }}>
          <h2 style={{ marginTop: 0 }}>Start AI Debate</h2>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
            <div>
              <label style={{ display: 'block', marginBottom: '0.5rem', fontWeight: '600' }}>Topic</label>
              <input
                type="text"
                value={topic}
                onChange={(e) => setTopic(e.target.value)}
                placeholder="e.g., Should AI replace human workers?"
                style={{
                  width: '100%',
                  padding: '12px',
                  borderRadius: '8px',
                  border: '1px solid #ddd',
                  fontSize: '1rem',
                  boxSizing: 'border-box'
                }}
              />
            </div>

            <div>
              <label style={{ display: 'block', marginBottom: '0.5rem', fontWeight: '600' }}>Your Side</label>
              <div style={{ display: 'flex', gap: '1rem' }}>
                <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', cursor: 'pointer' }}>
                  <input
                    type="radio"
                    name="side"
                    value="pro"
                    checked={userSide === 'pro'}
                    onChange={(e) => setUserSide(e.target.value)}
                  />
                  For (Pro)
                </label>
                <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', cursor: 'pointer' }}>
                  <input
                    type="radio"
                    name="side"
                    value="con"
                    checked={userSide === 'con'}
                    onChange={(e) => setUserSide(e.target.value)}
                  />
                  Against (Con)
                </label>
              </div>
            </div>

            {error && <div style={{ color: 'crimson', fontSize: '0.9rem' }}>{error}</div>}

            <div style={{ display: 'flex', gap: '1rem', justifyContent: 'flex-end', marginTop: '1rem' }}>
              <button
                onClick={() => navigate('/')}
                style={{
                  padding: '10px 20px',
                  borderRadius: '8px',
                  border: '1px solid #ddd',
                  backgroundColor: '#f5f5f5',
                  cursor: 'pointer',
                  fontWeight: '600'
                }}
              >
                Cancel
              </button>
              <button
                onClick={handleStartDebate}
                disabled={sending}
                style={{
                  padding: '10px 20px',
                  borderRadius: '8px',
                  border: 'none',
                  backgroundColor: '#222',
                  color: 'white',
                  cursor: sending ? 'not-allowed' : 'pointer',
                  fontWeight: '600',
                  opacity: sending ? 0.6 : 1
                }}
              >
                {sending ? 'Starting...' : 'Start Debate'}
              </button>
            </div>
          </div>
        </div>
      </div>
    );
  }

  if (!debate) {
    return (
      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', height: '100vh', backgroundColor: '#f5f0e6' }}>
        <div style={{ fontSize: '1.2rem', color: 'crimson' }}>Debate not found</div>
      </div>
    );
  }

  return (
    <div style={{
      display: 'flex',
      flexDirection: 'column',
      height: '100vh',
      backgroundColor: '#f5f0e6'
    }}>
      {/* Header */}
      <div style={{
        backgroundColor: 'white',
        borderBottom: '1px solid #ddd',
        padding: '1rem',
        display: 'flex',
        justifyContent: 'space-between',
        alignItems: 'center'
      }}>
        <div>
          <h2 style={{ margin: '0 0 0.5rem 0' }}>{debate.topic}</h2>
          <p style={{ margin: 0, fontSize: '0.9rem', color: '#666' }}>
            You: <strong style={{ color: userSide === 'pro' ? '#1976d2' : '#d32f2f' }}>{userSide.toUpperCase()}</strong> | AI: <strong style={{ color: debate.aiSide === 'pro' ? '#1976d2' : '#d32f2f' }}>{debate.aiSide.toUpperCase()}</strong>
          </p>
        </div>
        <button
          onClick={() => navigate('/')}
          style={{
            padding: '8px 16px',
            borderRadius: '6px',
            border: '1px solid #ddd',
            backgroundColor: '#f5f5f5',
            cursor: 'pointer',
            fontWeight: '600'
          }}
        >
          Back
        </button>
      </div>

      {/* Messages */}
      <div
        ref={scrollRef}
        onScroll={handleScroll}
        style={{
          flex: 1,
          overflowY: 'auto',
          padding: '15px',
          display: 'flex',
          flexDirection: 'column',
          gap: '15px',
          backgroundColor: '#fff'
        }}
      >
        {messages.map((msg, idx) => {
          const isUserMessage = msg.role === 'user';
          const sideForColor = isUserMessage ? userSide : debate.aiSide;
          const isBlueSide = sideForColor === 'pro';
          const bubbleColor = isBlueSide ? '#e3f2fd' : '#ffebee';
          const textColor = isBlueSide ? '#0d47a1' : '#b71c1c';
          const sender = isUserMessage ? 'You' : 'AI';

          return (
            <div
              key={idx}
              style={{
                display: 'flex',
                flexDirection: 'column',
                alignItems: isUserMessage ? 'flex-end' : 'flex-start'
              }}
            >
              <div style={{ display: 'flex', alignItems: 'center', marginBottom: '4px' }}>
                <span style={{ fontSize: '0.75rem', color: '#aaa' }}>
                  {sender}
                </span>
              </div>

              <div
                style={{
                  maxWidth: '70%',
                  padding: '10px 14px',
                  fontSize: '0.95rem',
                  backgroundColor: bubbleColor,
                  color: textColor,
                  borderRadius: '12px',
                  borderTopRightRadius: isUserMessage ? '2px' : '12px',
                  borderTopLeftRadius: isUserMessage ? '12px' : '2px',
                  wordWrap: 'break-word'
                }}
              >
                {msg.content}
              </div>
            </div>
          );
        })}
      </div>

      {error && (
        <div style={{
          backgroundColor: '#ffe6e6',
          color: 'crimson',
          padding: '1rem',
          textAlign: 'center',
          fontSize: '0.9rem'
        }}>
          {error}
        </div>
      )}

      {/* Input */}
      <div style={{
        backgroundColor: 'white',
        borderTop: '1px solid #ddd',
        padding: '1rem',
        display: 'flex',
        gap: '0.5rem'
      }}>
        <input
          type="text"
          value={inputText}
          onChange={(e) => setInputText(e.target.value)}
          onKeyPress={(e) => {
            if (e.key === 'Enter' && !sending) {
              handleSendMessage();
            }
          }}
          placeholder="Type your argument..."
          disabled={sending || debate.status === 'completed'}
          style={{
            flex: 1,
            padding: '12px',
            borderRadius: '8px',
            border: '1px solid #ddd',
            fontSize: '1rem',
            boxSizing: 'border-box'
          }}
        />
        <button
          onClick={handleSendMessage}
          disabled={!inputText.trim() || sending || debate.status === 'completed'}
          style={{
            padding: '12px 24px',
            borderRadius: '8px',
            border: 'none',
            backgroundColor: '#222',
            color: 'white',
            cursor: sending || !inputText.trim() ? 'not-allowed' : 'pointer',
            fontWeight: '600',
            opacity: sending || !inputText.trim() ? 0.6 : 1
          }}
        >
          {sending ? 'Sending...' : 'Send'}
        </button>
        <button
          onClick={handleEndDebate}
          style={{
            padding: '12px 24px',
            borderRadius: '8px',
            border: '1px solid #ddd',
            backgroundColor: '#f5f5f5',
            cursor: 'pointer',
            fontWeight: '600'
          }}
        >
          End
        </button>
      </div>
    </div>
  );
}
