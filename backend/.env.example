# Server
PORT=3000
NODE_ENV=development

# MongoDB
# IMPORTANT: Set these to strong, unique values in production
# For local development: mongodb://debate:debate@localhost:27017/debate_court?authSource=admin
# For Docker Compose production: mongodb://debate:debate@mongo:27017/debate_court?authSource=admin
MONGO_URI=mongodb://debate:debate@mongo:27017/debate_court?authSource=admin
MONGO_USER=debate
MONGO_PASSWORD=debate

# Session
# CRITICAL: Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters
SESSION_SECRET=your-super-secret-session-key-change-this

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Google Gemini API (for AI Debate features)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
